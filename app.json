{
  "expo": {
    "name": "Vedit",
    "slug": "vedit",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.vedit.app",
      "versionCode": 1,
      "permissions": [
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-image-picker",
      "expo-file-system"
    ]
  }
}
